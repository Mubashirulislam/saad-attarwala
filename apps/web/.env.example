NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shared secret checked by app/api/revalidate. Set the same value as
# NEXT_PUBLIC_REVALIDATE_SECRET in apps/admin/.env.local — different name on
# purpose, since the admin app sends it from the browser (needs the
# NEXT_PUBLIC_ prefix) but this app only ever reads it server-side.
REVALIDATE_SECRET=
