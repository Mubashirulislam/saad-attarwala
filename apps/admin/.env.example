NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public catalog app URL, used to trigger on-demand revalidation after saves.
NEXT_PUBLIC_WEB_APP_URL=https://saadswebsite.in
# Same value as REVALIDATE_SECRET in apps/web/.env.local. NEXT_PUBLIC_ here
# on purpose — notifyPublicSite() sends this from the browser, so it has to
# be readable client-side. This only guards against casual abuse of the
# revalidate endpoint (forced homepage re-renders), not sensitive data, so
# shipping it in the client bundle is an acceptable tradeoff.
NEXT_PUBLIC_REVALIDATE_SECRET=
